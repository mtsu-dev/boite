{
  "name": "@boite/core",
  "version": "2.0.0-beta.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "start": "bun run bin/core.ts",
    "dev": "bun run --watch src/main.ts",
    "build": "bun run bin/build.ts",
    "build:exe": "bun run build && bun run bin/compile.ts",
    "build:linux": "bun run build && bun run bin/compile.ts --target=bun-linux-x64-baseline --outfile=dist/boite-core-linux-x64 && bun run bin/stage-cli.ts",
    "check": "tsc -p tsconfig.json",
    "test": "bun run bin/test.ts",
    "test:serial": "bun run bin/test.ts --workers 1"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.1.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.312",
    "@boite/contracts": "workspace:*",
    "@modelcontextprotocol/server": "2.4.0",
    "diff": "9.0.0",
    "fflate": "0.8.3",
    "web-push": "^3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/web-push": "^3.6.4",
    "typescript": "^7.0.2"
  }
}
