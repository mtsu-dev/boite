{
  "id": "opencode",
  "schemaVersion": 1,
  "name": "OpenCode",
  "shortName": "OpenCode",
  "protocol": "acp",
  "roots": ["{home}/.local/share/opencode", "{home}/.config/opencode", "{isolationDir}"],
  "env": { "OPENCODE_CONFIG_CONTENT": "{\"permission\":{\"task\":\"deny\"}}" },
  "profiles": {
    "windows": {
      "detect": {},
      "update": { "args": ["upgrade"], "latestNpm": "opencode-ai" },
      "executable": [
        { "kind": "file", "value": "{agentsDir}/opencode.exe" },
        { "kind": "file", "value": "{npmRoot}/opencode-ai/bin/opencode.exe" },
        { "kind": "path", "value": "opencode", "major": 1 }
      ],
      "install": {
        "arch": "x64",
        "version": "1.18.31",
        "url": "https://github.com/sst/opencode/releases/download/v1.18.31/opencode-windows-x64.zip",
        "sha256": "0ecd7ffc7f26390ce7799e7bcd409e4f11c410144308a6a5b0fcdce63d871006",
        "archiveBytes": 60718498,
        "files": [{ "path": "opencode.exe", "bytes": 179998248 }]
      },
      "launch": { "args": ["acp", "--port", "0"] },
      "isolation": { "XDG_DATA_HOME": "{isolationDir}", "XDG_CONFIG_HOME": "{isolationDir}" },
      "close": { "processes": ["opencode.exe"] }
    },
    "linux": {
      "detect": {},
      "update": { "args": ["upgrade"], "latestNpm": "opencode-ai" },
      "executable": [
        { "kind": "path", "value": "opencode", "major": 1 },
        { "kind": "file", "value": "{npmRoot}/opencode-ai/bin/opencode.exe" },
        { "kind": "file", "value": "{home}/.opencode/bin/opencode", "major": 1 }
      ],
      "launch": { "args": ["acp", "--port", "0"] },
      "isolation": { "XDG_DATA_HOME": "{isolationDir}", "XDG_CONFIG_HOME": "{isolationDir}" },
      "close": { "processes": ["opencode"] }
    },
    "macos": {
      "detect": {},
      "update": { "args": ["upgrade"], "latestNpm": "opencode-ai" },
      "executable": [
        { "kind": "path", "value": "opencode", "major": 1 },
        { "kind": "file", "value": "{npmRoot}/opencode-ai/bin/opencode.exe" },
        { "kind": "file", "value": "{home}/.opencode/bin/opencode", "major": 1 }
      ],
      "launch": { "args": ["acp", "--port", "0"] },
      "isolation": { "XDG_DATA_HOME": "{isolationDir}", "XDG_CONFIG_HOME": "{isolationDir}" },
      "close": { "processes": ["opencode"] }
    }
  },
  "auth": { "kind": "oauth-cli", "session": ["opencode/auth.json"] },
  "login": { "command": ["opencode", "auth", "login"], "terminal": true },
  "shared": [
    {
      "variable": "XDG_CONFIG_HOME",
      "paths": ["opencode/opencode.json", "opencode/opencode.jsonc", "opencode/AGENTS.md", "opencode/package.json", "opencode/plugins", "opencode/plugin", "opencode/agents", "opencode/agent", "opencode/commands", "opencode/command", "opencode/skills", "opencode/node_modules"]
    }
  ],
  "hookSources": [
    { "variable": "XDG_CONFIG_HOME", "path": "opencode/plugins", "format": "modules" }
  ],
  "models": [{ "id": "default", "name": "OpenCode default", "default": true }],
  "capabilities": {
    "approvals": true,
    "hooks": true,
    "checkpoint": false,
    "images": false,
    "planMode": true,
    "resume": true
  }
}
