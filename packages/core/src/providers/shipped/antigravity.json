{
  "id": "antigravity",
  "schemaVersion": 1,
  "name": "Antigravity",
  "shortName": "Antigravity",
  "protocol": "acp",
  "roots": ["{agentsDir}", "{isolationDir}"],
  "profiles": {
    "windows": {
      "detect": { "file": "{agentsDir}/agy_acp_server.exe" },
      "executable": [{ "kind": "file", "value": "{agentsDir}/agy_acp_server.exe" }],
      "launch": { "args": [] },
      "install": {
        "version": "agy_acp_server_1.5.2",
        "arch": "x64",
        "url": "https://dl.google.com/agy-extensions/releases/windows/agy-acp-server-1.5.2-windows-x86_64.zip",
        "sha256": "5cbadd4f4df698572473d8890fc26ec2dc1724501f06e3a963941daec2bd21d6",
        "archiveBytes": 105407645,
        "files": [
          { "path": "agy_acp_server.exe", "bytes": 58368800 },
          { "path": "localharness_external.exe", "bytes": 155357336 }
        ]
      },
      "isolation": { "GEMINI_HOME": "{isolationDir}" },
      "env": {
        "AGY_ACP_FORCE_FILE_STORAGE": "1",
        "ANTIGRAVITY_HARNESS_PATH": "{agentsDir}/localharness_external.exe",
        "PYTHONUNBUFFERED": "1",
        "ELECTRON_RUN_AS_NODE": "1",
        "BROWSER": "{browserNoop}"
      },
      "unsetEnv": [
        "GEMINI_API_KEY",
        "GOOGLE_API_KEY",
        "GOOGLE_APPLICATION_CREDENTIALS",
        "GOOGLE_CLOUD_PROJECT",
        "GOOGLE_CLOUD_LOCATION",
        "GOOGLE_CLOUD_QUOTA_PROJECT",
        "GOOGLE_GENAI_USE_VERTEXAI",
        "GCLOUD_PROJECT",
        "CLOUDSDK_CORE_PROJECT",
        "AGY_ACP_CCPA_PROJECT",
        "AGY_ACP_ENABLE_OAUTH",
        "AGY_LLM_GATEWAY_URL",
        "AGY_LLM_GATEWAY_API_KEY",
        "GEMINI_HOME",
        "AGY_ACP_FORCE_FILE_STORAGE",
        "ANTIGRAVITY_HARNESS_PATH",
        "BROWSER",
        "PYTHONUNBUFFERED",
        "ELECTRON_RUN_AS_NODE"
      ],
      "close": { "processes": ["agy_acp_server.exe", "localharness_external.exe"] }
    },
    "linux": {
      "detect": { "file": "{agentsDir}/agy_acp_server.par" },
      "executable": [{ "kind": "file", "value": "{agentsDir}/agy_acp_server.par" }],
      "launch": { "args": ["--uid="] },
      "install": {
        "version": "agy_acp_server_1.5.2",
        "arch": "x64",
        "url": "https://dl.google.com/agy-extensions/releases/linux/agy-acp-server-1.5.2-linux-x86_64.zip",
        "sha256": "99dd8612450805011619d7b8447ce374c289e00549d8557f36790e1dd6256852",
        "archiveBytes": 273964075,
        "files": [
          { "path": "agy_acp_server.par", "bytes": 714384320 },
          { "path": "localharness_external", "bytes": 139194456, "executable": true }
        ]
      },
      "isolation": { "GEMINI_HOME": "{isolationDir}" },
      "env": {
        "AGY_ACP_FORCE_FILE_STORAGE": "1",
        "ANTIGRAVITY_HARNESS_PATH": "{agentsDir}/localharness_external",
        "PYTHONUNBUFFERED": "1",
        "ELECTRON_RUN_AS_NODE": "1",
        "BROWSER": "{browserNoop}"
      },
      "unsetEnv": [
        "GEMINI_API_KEY",
        "GOOGLE_API_KEY",
        "GOOGLE_APPLICATION_CREDENTIALS",
        "GOOGLE_CLOUD_PROJECT",
        "GOOGLE_CLOUD_LOCATION",
        "GOOGLE_CLOUD_QUOTA_PROJECT",
        "GOOGLE_GENAI_USE_VERTEXAI",
        "GCLOUD_PROJECT",
        "CLOUDSDK_CORE_PROJECT",
        "AGY_ACP_CCPA_PROJECT",
        "AGY_ACP_ENABLE_OAUTH",
        "AGY_LLM_GATEWAY_URL",
        "AGY_LLM_GATEWAY_API_KEY",
        "GEMINI_HOME",
        "AGY_ACP_FORCE_FILE_STORAGE",
        "ANTIGRAVITY_HARNESS_PATH",
        "BROWSER",
        "PYTHONUNBUFFERED",
        "ELECTRON_RUN_AS_NODE"
      ],
      "close": { "processes": ["agy_acp_server.par", "localharness_external"] }
    },
    "macos": {
      "detect": { "file": "{agentsDir}/agy_acp_server.par" },
      "executable": [{ "kind": "file", "value": "{agentsDir}/agy_acp_server.par" }],
      "launch": { "args": [] },
      "install": {
        "version": "agy_acp_server_1.5.2",
        "arch": "arm64",
        "url": "https://dl.google.com/agy-extensions/releases/macos/agy-acp-server-1.5.2-darwin-arm64.zip",
        "sha256": "123a16d5c40a8ac99e20f01a62b68dd860fd96b1c528dfb8eaa37ca8733d4845",
        "archiveBytes": 100309778,
        "files": [
          { "path": "agy_acp_server.par", "bytes": 179921328 },
          { "path": "localharness_external", "bytes": 129208672, "executable": true }
        ]
      },
      "isolation": { "GEMINI_HOME": "{isolationDir}" },
      "env": {
        "AGY_ACP_FORCE_FILE_STORAGE": "1",
        "ANTIGRAVITY_HARNESS_PATH": "{agentsDir}/localharness_external",
        "PYTHONUNBUFFERED": "1",
        "ELECTRON_RUN_AS_NODE": "1",
        "BROWSER": "{browserNoop}"
      },
      "unsetEnv": [
        "GEMINI_API_KEY",
        "GOOGLE_API_KEY",
        "GOOGLE_APPLICATION_CREDENTIALS",
        "GOOGLE_CLOUD_PROJECT",
        "GOOGLE_CLOUD_LOCATION",
        "GOOGLE_CLOUD_QUOTA_PROJECT",
        "GOOGLE_GENAI_USE_VERTEXAI",
        "GCLOUD_PROJECT",
        "CLOUDSDK_CORE_PROJECT",
        "AGY_ACP_CCPA_PROJECT",
        "AGY_ACP_ENABLE_OAUTH",
        "AGY_LLM_GATEWAY_URL",
        "AGY_LLM_GATEWAY_API_KEY",
        "GEMINI_HOME",
        "AGY_ACP_FORCE_FILE_STORAGE",
        "ANTIGRAVITY_HARNESS_PATH",
        "BROWSER",
        "PYTHONUNBUFFERED",
        "ELECTRON_RUN_AS_NODE"
      ],
      "close": { "processes": ["agy_acp_server.par", "localharness_external"] }
    }
  },
  "auth": { "kind": "oauth-cli", "session": ["antigravity-acp/acp_token.json"] },
  "login": { "acp": { "methodId": "oauth-personal" } },
  "isolation": { "alwaysIsolated": true },
  "seedFiles": { "antigravity-acp/settings.json": "{\"auth\":{\"type\":\"oauth-personal\"}}" },
  "shared": [{ "variable": "GEMINI_HOME", "paths": ["config/skills", "antigravity-cli/skills"] }],
  "quirks": ["antigravity"],
  "models": [{ "id": "default", "name": "Antigravity default", "default": true }],
  "capabilities": {
    "approvals": true,
    "hooks": false,
    "checkpoint": false,
    "images": true,
    "planMode": false,
    "resume": true
  }
}
