{
  "id": "antigravity",
  "schemaVersion": 1,
  "name": "Antigravity",
  "shortName": "Antigravity",
  "protocol": "acp",
  "roots": ["{agentsDir}", "{isolationDir}"],
  "profiles": {
    "windows": {
      "detect": { "file": "{agentsDir}/agy_acp_server.exe" },
      "executable": [{ "kind": "file", "value": "{agentsDir}/agy_acp_server.exe" }],
      "launch": { "args": [] },
      "install": {
        "version": "agy_acp_server_1.4.5",
        "arch": "x64",
        "url": "https://dl.google.com/agy-extensions/releases/windows/agy-acp-server-1.4.5-windows-x86_64.zip",
        "sha256": "d24f4c73c9f96d4f44384e281c855a56c72d8eaa9c5b0fad7ccb1635c6b63f50",
        "archiveBytes": 100423655,
        "files": [
          { "path": "agy_acp_server.exe", "bytes": 55839864 },
          { "path": "localharness_external.exe", "bytes": 147843736 }
        ]
      },
      "isolation": { "GEMINI_HOME": "{isolationDir}" },
      "env": {
        "AGY_ACP_FORCE_FILE_STORAGE": "1",
        "ANTIGRAVITY_HARNESS_PATH": "{agentsDir}/localharness_external.exe",
        "PYTHONUNBUFFERED": "1",
        "ELECTRON_RUN_AS_NODE": "1",
        "BROWSER": "{browserNoop}"
      },
      "unsetEnv": [
        "GEMINI_API_KEY",
        "GOOGLE_API_KEY",
        "GOOGLE_APPLICATION_CREDENTIALS",
        "GOOGLE_CLOUD_PROJECT",
        "GOOGLE_CLOUD_LOCATION",
        "GOOGLE_CLOUD_QUOTA_PROJECT",
        "GOOGLE_GENAI_USE_VERTEXAI",
        "GCLOUD_PROJECT",
        "CLOUDSDK_CORE_PROJECT",
        "AGY_ACP_CCPA_PROJECT",
        "AGY_ACP_ENABLE_OAUTH",
        "GEMINI_HOME",
        "AGY_ACP_FORCE_FILE_STORAGE",
        "ANTIGRAVITY_HARNESS_PATH",
        "BROWSER",
        "PYTHONUNBUFFERED",
        "ELECTRON_RUN_AS_NODE"
      ],
      "close": { "processes": ["agy_acp_server.exe", "localharness_external.exe"] }
    },
    "linux": {
      "detect": { "file": "{agentsDir}/agy_acp_server.par" },
      "executable": [{ "kind": "file", "value": "{agentsDir}/agy_acp_server.par" }],
      "launch": { "args": ["--uid="] },
      "install": {
        "version": "agy_acp_server_1.4.5",
        "arch": "x64",
        "url": "https://dl.google.com/agy-extensions/releases/linux/agy-acp-server-1.4.5-linux-x86_64.zip",
        "sha256": "923923a0d7dc8073f66cc6f78647a3107e3a7ee2b7e1a24df8b3927b5188013b",
        "archiveBytes": 321783181,
        "files": [
          { "path": "agy_acp_server.par", "bytes": 826226766 },
          { "path": "localharness_external", "bytes": 133926136, "executable": true }
        ]
      },
      "isolation": { "GEMINI_HOME": "{isolationDir}" },
      "env": {
        "AGY_ACP_FORCE_FILE_STORAGE": "1",
        "ANTIGRAVITY_HARNESS_PATH": "{agentsDir}/localharness_external",
        "PYTHONUNBUFFERED": "1",
        "ELECTRON_RUN_AS_NODE": "1",
        "BROWSER": "{browserNoop}"
      },
      "unsetEnv": [
        "GEMINI_API_KEY",
        "GOOGLE_API_KEY",
        "GOOGLE_APPLICATION_CREDENTIALS",
        "GOOGLE_CLOUD_PROJECT",
        "GOOGLE_CLOUD_LOCATION",
        "GOOGLE_CLOUD_QUOTA_PROJECT",
        "GOOGLE_GENAI_USE_VERTEXAI",
        "GCLOUD_PROJECT",
        "CLOUDSDK_CORE_PROJECT",
        "AGY_ACP_CCPA_PROJECT",
        "AGY_ACP_ENABLE_OAUTH",
        "GEMINI_HOME",
        "AGY_ACP_FORCE_FILE_STORAGE",
        "ANTIGRAVITY_HARNESS_PATH",
        "BROWSER",
        "PYTHONUNBUFFERED",
        "ELECTRON_RUN_AS_NODE"
      ],
      "close": { "processes": ["agy_acp_server.par", "localharness_external"] }
    },
    "macos": {
      "detect": { "file": "{agentsDir}/agy_acp_server.par" },
      "executable": [{ "kind": "file", "value": "{agentsDir}/agy_acp_server.par" }],
      "launch": { "args": [] },
      "install": {
        "version": "agy_acp_server_1.4.5",
        "arch": "arm64",
        "url": "https://dl.google.com/agy-extensions/releases/macos/agy-acp-server-1.4.5-darwin-arm64.zip",
        "sha256": "886fff7767d08994ca39eb02c3d01a7532c7325a94aa33aaf52d52068733284f",
        "archiveBytes": 97923855,
        "files": [
          { "path": "agy_acp_server.par", "bytes": 178915920 },
          { "path": "localharness_external", "bytes": 122957936, "executable": true }
        ]
      },
      "isolation": { "GEMINI_HOME": "{isolationDir}" },
      "env": {
        "AGY_ACP_FORCE_FILE_STORAGE": "1",
        "ANTIGRAVITY_HARNESS_PATH": "{agentsDir}/localharness_external",
        "PYTHONUNBUFFERED": "1",
        "ELECTRON_RUN_AS_NODE": "1",
        "BROWSER": "{browserNoop}"
      },
      "unsetEnv": [
        "GEMINI_API_KEY",
        "GOOGLE_API_KEY",
        "GOOGLE_APPLICATION_CREDENTIALS",
        "GOOGLE_CLOUD_PROJECT",
        "GOOGLE_CLOUD_LOCATION",
        "GOOGLE_CLOUD_QUOTA_PROJECT",
        "GOOGLE_GENAI_USE_VERTEXAI",
        "GCLOUD_PROJECT",
        "CLOUDSDK_CORE_PROJECT",
        "AGY_ACP_CCPA_PROJECT",
        "AGY_ACP_ENABLE_OAUTH",
        "GEMINI_HOME",
        "AGY_ACP_FORCE_FILE_STORAGE",
        "ANTIGRAVITY_HARNESS_PATH",
        "BROWSER",
        "PYTHONUNBUFFERED",
        "ELECTRON_RUN_AS_NODE"
      ],
      "close": { "processes": ["agy_acp_server.par", "localharness_external"] }
    }
  },
  "auth": { "kind": "oauth-cli", "session": ["antigravity-acp/acp_token.json"] },
  "login": { "acp": { "methodId": "oauth-personal" } },
  "isolation": { "alwaysIsolated": true },
  "seedFiles": { "antigravity-acp/settings.json": "{\"auth\":{\"type\":\"oauth-personal\"}}" },
  "shared": [{ "variable": "GEMINI_HOME", "paths": ["config/skills", "antigravity-cli/skills"] }],
  "quirks": ["antigravity"],
  "models": [{ "id": "default", "name": "Antigravity default", "default": true }],
  "capabilities": {
    "approvals": true,
    "hooks": false,
    "checkpoint": false,
    "images": true,
    "planMode": false,
    "resume": true
  }
}
