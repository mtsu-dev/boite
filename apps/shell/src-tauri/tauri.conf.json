{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Boite",
  "version": "0.1.1",
  "identifier": "com.boite.two",
  "plugins": {
    "opener": { "requireLiteralLeadingDot": false },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxQUMwNkU2MzREQjRFMTUKUldRVlR0czA1Z2Fzc1JuNTArSldvdXVsRi9NbGNrTWQ5QUFxcmdOZXllRnBKL1djRFVwMFg3MS8K",
      "requireSignedVersion": true,
      "windows": { "installMode": "quiet" }
    }
  },
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run --cwd ../../packages/ui dev",
    "beforeBuildCommand": "bun run --cwd ../../packages/ui build && bun scripts/stage-frontend.ts"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://127.0.0.1:* http://*:*/file/ https://*:*/file/; media-src 'self' blob: http://127.0.0.1:* http://*:*/file/ https://*:*/file/; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:* ws: wss:; frame-src 'self' blob: http://127.0.0.1:* http://*:*/view/ https://*:*/view/; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons-dev/32x32.png",
      "icons-dev/128x128.png",
      "icons-dev/128x128@2x.png",
      "icons-dev/icon.icns",
      "icons-dev/icon.ico"
    ]
  }
}
