{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Boite",
  "version": "2.0.0-beta.1",
  "identifier": "com.boite.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run --cwd ../../packages/ui dev --mode mobile",
    "beforeBuildCommand": "bun run --cwd ../../packages/ui build --mode mobile --outDir ../../apps/mobile/dist --emptyOutDir"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Boite" }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http: https:; media-src 'self' blob: http: https:; font-src 'self'; connect-src ipc: http://ipc.localhost http: https: ws: wss:; frame-src 'self' blob:; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
