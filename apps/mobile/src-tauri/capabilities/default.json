{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "default",
  "description": "The page may open web links in the system browser, nothing else.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "http://*" }, { "url": "https://*" }] }
  ]
}
